version: '3'

services:
    # Service de base de données MariaDB
    mariadb:
        image: bitnami/mariadb:11.4.6-debian-12-r0
        environment:
            - ALLOW_EMPTY_PASSWORD=no
            - MARIADB_ROOT_PASSWORD=${DB_ROOT_PASSWORD:-root_password}
            - MARIADB_USER=${DB_USERNAME}
            - MARIADB_PASSWORD=${DB_PASSWORD}
            - MARIADB_DATABASE=${DB_DATABASE}
        volumes:
            - mariadb_data:/bitnami/mariadb
        networks:
            - app-network

    # Service Laravel (application web)
    laravel:
        build:
            context: .
            dockerfile: Dockerfile
        ports:
            - "8000:8000"
        environment:
            - DB_HOST=${DB_HOST}
            - DB_PORT=${DB_PORT}
            - DB_USERNAME=${DB_USERNAME}
            - DB_DATABASE=${DB_DATABASE}
            - DB_PASSWORD=${DB_PASSWORD}
            - ENV LARAVEL_SKIP_CHOWN=yes
        volumes:
            - ./:/app
        depends_on:
            - mariadb
        networks:
            - app-network

networks:
    app-network:
        driver: bridge

volumes:
    mariadb_data:
        driver: local
