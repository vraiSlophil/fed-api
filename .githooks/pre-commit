#!/usr/bin/env sh
set -eu

if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  if docker compose version >/dev/null 2>&1; then
    COMPOSE="docker compose"
  elif command -v docker-compose >/dev/null 2>&1; then
    COMPOSE="docker-compose"
  else
    echo "docker compose not found; skipping lint." >&2
    exit 0
  fi

  run_in_container() {
    if ${COMPOSE} ps -q laravel >/dev/null 2>&1 && [ -n "$(${COMPOSE} ps -q laravel 2>/dev/null || true)" ]; then
      ${COMPOSE} exec -T laravel sh -c "$1"
    else
      ${COMPOSE} run --rm --no-deps --remove-orphans laravel sh -c "$1"
    fi
  }

  # Fichiers PHP déjà stagés
  STAGED_PHP=$(git diff --name-only --cached --diff-filter=ACM -- '*.php' | tr '\n' ' ')

  if [ -n "$STAGED_PHP" ]; then
    echo "Running composer lint on staged PHP files..."
    run_in_container "composer lint -- $STAGED_PHP"
    # Ré‑ajoute les modifs de Pint au commit courant
    git add $STAGED_PHP
  else
    echo "No staged PHP files; skipping lint."
  fi
  exit 0
fi

echo "Docker is not available/running; cannot run lint in container." >&2
echo "Start Docker, or bypass with: git commit --no-verify" >&2
exit 1
