meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/register
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  X-XSRF-TOKEN: {{xsrf_token}}
  Cookie: XSRF-TOKEN={{xsrf_token}}; fed_api_session={{fed_api_session}}
  Referer: {{baseUrl}}
}

body:json {
  {
    "username": "test",
    "email": "test@example.com",
    "password": "password",
    "password_confirmation": "password"
  }
}
