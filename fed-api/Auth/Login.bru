meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/login
  body: json
  auth: inherit
}

headers {
 Accept: application/json
 X-XSRF-TOKEN: {{xsrf_token}}
 Cookie: XSRF-TOKEN={{xsrf_token}}; fed_api_session={{fed_api_session}}
}

body:json {
 {
   "email": "test@example.com",
   "password": "password"
 }
}
